model RefreshToken {
  id     Int    @id @default(autoincrement())
  token  String @db.VarChar(255)
  userId String @db.Uuid

  expiredAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiredAt])
  @@map("refresh_tokens")
}
